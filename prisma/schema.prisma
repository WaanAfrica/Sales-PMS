generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum ReportStatus {
  PENDING
  DRAFT
  SUBMITTED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(SALES)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dailySales      DailySales[]
  monthlyTargets  MonthlyTarget[]
}

model DailySales {
  id                   String   @id @default(cuid())
  userId               String
  date                 DateTime
  salesRevenue         Float
  repeatCustomers      Int
  newCustomers         Int
  walkIns              Int
  dailyAcquisition     Int @default(0)
  newQuotations        Int
  closedQuotations     Int
  quotationAge         Float
  hotQuotationValue    Float
  salesPipelineValue   Float
  accountsReceivable   Float
  opportunities        String?
  challenges           String?
  status               ReportStatus @default(PENDING)
  submittedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MonthlyTarget {
  id                   String   @id @default(cuid())
  userId               String
  month                Int
  year                 Int
  salesRevenueTarget   Float
  repeatCustomerTarget Int
  newCustomerTarget    Int
  walkInTarget         Int
  quotationTarget      Int
  pipelineTarget       Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}
